# ── Kalshi authentication ──────────────────────────────────────────────────
# Key ID (from the .env file Kalshi gave you when you created an API key)
KALSHI_API_KEY_ID=your-key-id-here

# Path to the private key .txt file Kalshi gave you (forward slashes on Windows too)
KALSHI_PRIVATE_KEY_PATH=C:/Users/yourname/Downloads/kalshi-private-key.txt

# Option 2: email + password instead of API key
# KALSHI_EMAIL=your-email@example.com
# KALSHI_PASSWORD=your-password

# ── Anthropic API key (REQUIRED — powers the market matching) ───────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Cross-market divergence settings (all optional) ─────────────────────────
# A "divergence" = Kalshi and Polymarket pricing the same event differently.

KALSHI_MIN_VOLUME_24H=200   # Min Kalshi 24h volume (contracts) to consider
POLY_MIN_VOLUME_24H=500     # Min Polymarket 24h volume (USD) to consider
MIN_GAP_POINTS=5            # Only report gaps this wide, in percentage points
MAX_DAYS_TO_CLOSE=180       # Ignore markets resolving further out than this
MAX_MATCH_CHECKS=60         # Max AI match-confirmations per run (cost control)
TOP_N_MARKETS=15            # How many divergences to show in the report

# ── Output ─────────────────────────────────────────────────────────────────
OUTPUT_DIR=./reports        # Where JSON + HTML reports are saved
