# ── Kalshi authentication ──────────────────────────────────────────────────
# Key ID (from the .env file Kalshi gave you when you created an API key)
KALSHI_API_KEY_ID=your-key-id-here

# Path to the private key .txt file Kalshi gave you (forward slashes on Windows too)
KALSHI_PRIVATE_KEY_PATH=C:/Users/yourname/Downloads/kalshi-private-key.txt

# Option 2: email + password instead of API key
# KALSHI_EMAIL=your-email@example.com
# KALSHI_PASSWORD=your-password

# ── Anthropic API key ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Safety gates ───────────────────────────────────────────────────────────
# A market must pass ALL THREE gates or it is skipped entirely.
#
# Gate 1: Extreme consensus — dominant outcome must be this confident
MIN_CONSENSUS=0.88        # 0.88 = 88% (i.e. 88¢ YES or 88¢ NO)
#
# Gate 2: Time decay — too much time left = too much risk of surprise
MAX_HOURS_TO_EXPIRY=48    # Only markets resolving within 48 hours
#
# Gate 3: Liquidity — spread must be tight AND volume must be deep
MAX_SPREAD_CENTS=2        # Bid-ask spread ≤ 2¢
MIN_VOLUME_24H=5000       # At least 5,000 contracts traded in last 24h

# ── Output settings ────────────────────────────────────────────────────────
TOP_N_MARKETS=10          # How many top picks to surface in the report
OUTPUT_DIR=./reports      # Where to save the JSON report
