# ── Kalshi authentication ──────────────────────────────────────────────────
# Key ID (from the .env file Kalshi gave you when you created an API key)
KALSHI_API_KEY_ID=your-key-id-here

# Path to the private key .txt file Kalshi gave you (forward slashes on Windows too)
KALSHI_PRIVATE_KEY_PATH=C:/Users/yourname/Downloads/kalshi-private-key.txt

# ── Anthropic API key ──────────────────────────────────────────────────────
# Required only for the Polymarket divergence tool (npm run divergence).
# The weather tool (npm start) does NOT need it.
ANTHROPIC_API_KEY=sk-ant-...

# ══════════════════════════════════════════════════════════════════════════
#  WEATHER EDGE  (npm start)  — compares NWS forecasts to Kalshi temp markets
# ══════════════════════════════════════════════════════════════════════════
WEATHER_KERNEL=1.5         # Smoothing per ensemble member in °F (accounts for rounding/station noise)
WEATHER_MIN_EDGE=0.08      # Only show edges above this (0.08 = 8 percentage points)
WEATHER_MIN_CONTRACTS=10   # Skip edges you can't fill at least this many contracts of
WEATHER_INCLUDE_TODAY=false # true = also include same-day (near-resolved) markets
BANKROLL_USD=1000          # Your bankroll, for Kelly stake sizing
FRACTIONAL_KELLY=0.25      # Quarter-Kelly (safer than full Kelly)
MAX_FRACTION_PER_TRADE=0.05 # Never risk more than 5% of bankroll on one bet
# WEATHER_CITIES=KXHIGHNY,KXHIGHCHI   # Optional: limit to specific city series

# ══════════════════════════════════════════════════════════════════════════
#  POLYMARKET DIVERGENCE  (npm run divergence)  — needs ANTHROPIC_API_KEY
# ══════════════════════════════════════════════════════════════════════════
KALSHI_MIN_VOLUME_24H=200
POLY_MIN_VOLUME_24H=500
MIN_GAP_POINTS=5
MAX_DAYS_TO_CLOSE=180
MAX_MATCH_CHECKS=60
TOP_N_MARKETS=15

# ── Output ─────────────────────────────────────────────────────────────────
OUTPUT_DIR=./reports
