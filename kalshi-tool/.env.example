# ── Kalshi authentication ──────────────────────────────────────────────────
# When you create an API key in Kalshi dashboard (Settings → API Keys), you
# get two files: a .env file with the key ID and a .txt file with the private key.

# Key ID (from the .env file Kalshi gave you)
KALSHI_API_KEY_ID=your-key-id-here

# Path to the private key .txt file Kalshi gave you
# Use forward slashes even on Windows, e.g.:
#   C:/Users/yourname/Downloads/kalshi-private-key.txt
KALSHI_PRIVATE_KEY_PATH=C:/path/to/your/kalshi-private-key.txt

# Alternative: paste the raw PEM key inline (use KALSHI_PRIVATE_KEY instead of PATH)
# KALSHI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Option 2: email + password instead of API key (simpler but less secure)
# KALSHI_EMAIL=your-email@example.com
# KALSHI_PASSWORD=your-password

# ── Anthropic API key (for AI explanations) ────────────────────────────────
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Report settings (all optional) ────────────────────────────────────────
TOP_N_MARKETS=10          # How many safe bets to surface (default: 10)
MIN_VOLUME=1000           # Minimum total volume to consider a market (default: 1000)
MIN_PROBABILITY_SKEW=0.65 # Minimum probability skew e.g. 0.65 = 65¢ YES (default: 0.65)
OUTPUT_DIR=./reports      # Where to save weekly reports (default: ./reports)
