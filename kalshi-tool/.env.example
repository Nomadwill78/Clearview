# Kalshi credentials
# Option 1: Email + password (simpler)
KALSHI_EMAIL=your-email@example.com
KALSHI_PASSWORD=your-password

# Option 2: API key (more secure — generate in Kalshi dashboard under Settings > API)
# KALSHI_API_KEY_ID=your-key-id
# KALSHI_API_PRIVATE_KEY=your-private-key-pem

# Anthropic API key (for AI-powered explanations)
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Report settings (optional)
TOP_N_MARKETS=10          # How many safe bets to surface (default: 10)
MIN_VOLUME=1000           # Minimum total volume to consider a market (default: 1000)
MIN_PROBABILITY_SKEW=0.65 # Minimum probability to flag as "safe" e.g. 0.65 = 65¢ YES (default: 0.65)
OUTPUT_DIR=./reports      # Where to save weekly reports (default: ./reports)
