# ──────────────────────────────────────────────────────────────────────
# FlipOS environment variables
# Copy this file to .env.local and fill in real values for local dev.
# Add the SAME variables in Vercel: Project → Settings → Environment Variables
# (all environments), then redeploy.
# The app runs fine with ALL of these empty — features light up as keys
# are added. Never commit .env.local.
# ──────────────────────────────────────────────────────────────────────

# ── Clerk (sign-in) — clerk.com → your app → API Keys ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Stripe (payments) — dashboard.stripe.com → Developers → API keys ──
STRIPE_SECRET_KEY=

# Price IDs from your "FlipOS Pro" product (each starts with price_)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Webhook signing secret (whsec_…) — created when you add the webhook
# endpoint https://flipos-tau.vercel.app/api/stripe-webhook in
# Stripe → Developers → Webhooks, sending these events:
#   checkout.session.completed
#   customer.subscription.updated
#   customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
