# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Configuration (use test keys for development)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Anthropic Claude API (used server-side in Edge Functions only)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Stripe Secret (used server-side in Edge Functions only)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_STARSEED_MONTHLY_PRICE_ID=price_your_starseed_monthly_id
STRIPE_COSMIC_YEARLY_PRICE_ID=price_your_cosmic_yearly_id

# App URL (for redirects after Stripe checkout)
EXPO_PUBLIC_APP_URL=celestial://
